<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AspxLint.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.2" />
    <ProjectReference Include="..\AspxLint.Core\AspxLint.Core.csproj" />
  </ItemGroup>

  <!--
    Embed la dashboard HTML + ses fragments (CSS, JS, partials) comme
    ressources dans AspxLint.Server.dll. Cf. src/AspxLint.Web/README.md.
       - index.html contient des marqueurs {{include:NAME}} qui sont resolus
         par ServerHost.ExpandIncludes() au moment de la requete.
       - LogicalName fige les noms de ressources avec '/' -> '.', pour matcher
         la convention attendue par ExpandIncludes en mode embedded.
       - En dev, ServerHost lit les fichiers depuis le disque (hot-reload).
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\AspxLint.Web\index.html"
                      Link="aspx_lint_dashboard.html"
                      LogicalName="AspxLint.Web.index.html" />
    <EmbeddedResource Include="..\AspxLint.Web\styles.css"
                      Link="styles.css"
                      LogicalName="AspxLint.Web.styles.css" />
    <EmbeddedResource Include="..\AspxLint.Web\favicon.ico"
                      Link="favicon.ico"
                      LogicalName="AspxLint.Web.favicon.ico" />
    <!--
      app.js a ete decoupe en 17 modules dans src/AspxLint.Web/modules/.
      Index.html les inclut un par un via {{include:modules/NN-name.js}}.
    -->
    <EmbeddedResource Include="..\AspxLint.Web\modules\01-state.js"
                      Link="modules\01-state.js"
                      LogicalName="AspxLint.Web.modules.01-state.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\02-files-tree.js"
                      Link="modules\02-files-tree.js"
                      LogicalName="AspxLint.Web.modules.02-files-tree.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\03-analysis.js"
                      Link="modules\03-analysis.js"
                      LogicalName="AspxLint.Web.modules.03-analysis.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\04-highlight.js"
                      Link="modules\04-highlight.js"
                      LogicalName="AspxLint.Web.modules.04-highlight.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\05-render-code.js"
                      Link="modules\05-render-code.js"
                      LogicalName="AspxLint.Web.modules.05-render-code.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\06-minimap.js"
                      Link="modules\06-minimap.js"
                      LogicalName="AspxLint.Web.modules.06-minimap.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\07-diff.js"
                      Link="modules\07-diff.js"
                      LogicalName="AspxLint.Web.modules.07-diff.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\08-edit-issues-stats.js"
                      Link="modules\08-edit-issues-stats.js"
                      LogicalName="AspxLint.Web.modules.08-edit-issues-stats.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\09-actions.js"
                      Link="modules\09-actions.js"
                      LogicalName="AspxLint.Web.modules.09-actions.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\10-fileio-server.js"
                      Link="modules\10-fileio-server.js"
                      LogicalName="AspxLint.Web.modules.10-fileio-server.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\11-bulk.js"
                      Link="modules\11-bulk.js"
                      LogicalName="AspxLint.Web.modules.11-bulk.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\12-modals-toast.js"
                      Link="modules\12-modals-toast.js"
                      LogicalName="AspxLint.Web.modules.12-modals-toast.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\13-dragdrop.js"
                      Link="modules\13-dragdrop.js"
                      LogicalName="AspxLint.Web.modules.13-dragdrop.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\14-search.js"
                      Link="modules\14-search.js"
                      LogicalName="AspxLint.Web.modules.14-search.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\15-palette.js"
                      Link="modules\15-palette.js"
                      LogicalName="AspxLint.Web.modules.15-palette.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\16-keyboard.js"
                      Link="modules\16-keyboard.js"
                      LogicalName="AspxLint.Web.modules.16-keyboard.js" />
    <EmbeddedResource Include="..\AspxLint.Web\modules\17-desktop-sse.js"
                      Link="modules\17-desktop-sse.js"
                      LogicalName="AspxLint.Web.modules.17-desktop-sse.js" />
    <EmbeddedResource Include="..\AspxLint.Web\partials\modal-paste.html"
                      Link="partials\modal-paste.html"
                      LogicalName="AspxLint.Web.partials.modal-paste.html" />
    <EmbeddedResource Include="..\AspxLint.Web\partials\modal-browse.html"
                      Link="partials\modal-browse.html"
