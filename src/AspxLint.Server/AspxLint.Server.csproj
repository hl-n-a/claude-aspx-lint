<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AspxLint.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <ProjectReference Include="..\AspxLint.Core\AspxLint.Core.csproj" />
  </ItemGroup>

  <!--
    Embed la dashboard HTML + ses fragments (CSS, JS, partials) comme
    ressources dans AspxLint.Server.dll. Cf. src/AspxLint.Web/README.md.
       - index.html contient des marqueurs {{include:NAME}} qui sont resolus
         par ServerHost.ExpandIncludes() au moment de la requete.
       - LogicalName fige les noms de ressources avec '/' -> '.', pour matcher
         la convention attendue par ExpandIncludes en mode embedded.
       - En dev, ServerHost lit les fichiers depuis le disque (hot-reload).
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\AspxLint.Web\index.html"
                      Link="aspx_lint_dashboard.html"
                      LogicalName="AspxLint.Web.index.html" />
    <EmbeddedResource Include="..\AspxLint.Web\styles.css"
                      Link="styles.css"
                      LogicalName="AspxLint.Web.styles.css" />
    <EmbeddedResource Include="..\AspxLint.Web\app.js"
                      Link="app.js"
                      LogicalName="AspxLint.Web.app.js" />
    <EmbeddedResource Include="..\AspxLint.Web\partials\modal-paste.html"
                      Link="partials\modal-paste.html"
                      LogicalName="AspxLint.Web.partials.modal-paste.html" />
    <EmbeddedResource Include="..\AspxLint.Web\partials\modal-browse.html"
                      Link="partials\modal-browse.html"
                      LogicalName="AspxLint.Web.partials.modal-browse.html" />
    <EmbeddedResource Include="..\AspxLint.Web\partials\modal-rules.html"
                      Link="partials\modal-rules.html"
                      LogicalName="AspxLint.Web.partials.modal-rules.html" />
    <EmbeddedResource Include="..\AspxLint.Web\partials\modal-palette.html"
                      Link="partials\modal-palette.html"
                      LogicalName="AspxLint.Web.partials.modal-palette.html" />
    <EmbeddedResource Include="..\AspxLint.Web\partials\modal-batch-report.html"
                      Link="partials\modal-batch-report.html"
                      LogicalName="AspxLint.Web.partials.modal-batch-report.html" />
  </ItemGroup>

</Project>
