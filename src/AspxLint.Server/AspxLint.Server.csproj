                      LogicalName="AspxLint.Web.partials.modal-palette.html" />
    <EmbeddedResource Include="..\AspxLint.Web\partials\modal-batch-report.html"
                      Link="partials\modal-batch-report.html"
                      LogicalName="AspxLint.Web.partials.modal-batch-report.html" />
  </ItemGroup>

</Project>
